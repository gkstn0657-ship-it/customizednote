{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "description": "__MSG_extDesc__",
  "version": "1.4.0",
  "default_locale": "ko",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Daily Memo"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+M",
        "mac": "Alt+Shift+M"
      },
      "description": "메모장 열기"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "contextMenus",
    "unlimitedStorage",
    "identity",
    "alarms"
  ],
  "oauth2": {
    "client_id": "743875247294-m5mapjrbh7js5isupb20piq0q2mo74gn.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.appdata"
    ]
  }
}
